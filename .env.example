# Media Stack Cron Jobs Environment Configuration

# Sonarr & Radarr (Required by sanitize scripts, backlog_fetcher, stream health, import guard/rescue)
SONARR_URL="http://localhost:8989/api/v3"
SONARR_API_KEY="your_sonarr_api_key_here"

RADARR_URL="http://localhost:7878/api/v3"
RADARR_API_KEY="your_radarr_api_key_here"

# Cloudflare DDNS (Required by update_cloudflare_dns.py)
CF_API_TOKEN="your_cloudflare_api_token"
CF_ZONE_ID="your_cloudflare_zone_id"
CF_RECORD_NAME="your_dns_record_name"

# NzbDAV Watchdog (Required by nzbdav_auth_guard.py)
NZBDAV_CONTAINER="nzbdav"
NZBDAV_DB="/opt/nzbdav/config/db.sqlite"
NZBDAV_WEBDAV="http://127.0.0.1:3000/"
NZBDAV_AUTH_GUARD_STATE="/home/admin/nzbdav-auth-guard-state.json"

# Jellyfin (Required by jellyfin_safe_refresh_wrapper.py, media_stack_monitor.py)
JELLYFIN_DB="/opt/jellyfin/config/data/data/jellyfin.db"
